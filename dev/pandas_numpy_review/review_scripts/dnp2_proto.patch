     return fit_kwargs
 
 
+def add_estimator_categorical_index(
+    estimator: object,
+    cat_index: int,
+    n_features: int,
+    fit_kwargs: dict[str, Any]
+) -> dict[str, object]:
+    """
+    PROTOTYPE (D-NP2). Add the column `cat_index` to the categorical features
+    the user has configured on the estimator (by index), without removing
+    them. Used for the level column of `encoding='ordinal_category'` when
+    `categorical_features` is `None`.
+    """
+
+    target = estimator[-1] if isinstance(estimator, Pipeline) else estimator
+    name = type(target).__name__
+    module = type(target).__module__.split('.')[0]
+
+    if module == 'lightgbm':
+        prev = fit_kwargs.get('categorical_feature', 'auto')
+        prev = [] if isinstance(prev, str) else list(prev)
+        fit_kwargs['categorical_feature'] = sorted(set(prev) | {cat_index})
+    elif module == 'catboost':
+        if target.get_params().get('cat_features') is not None:
+            prev = list(target.get_params()['cat_features'])
+            target.set_params(cat_features=sorted(set(prev) | {cat_index}))
+        else:
+            prev = list(fit_kwargs.get('cat_features', []))
+            fit_kwargs['cat_features'] = sorted(set(prev) | {cat_index})
+    elif module == 'xgboost':
+        prev = target.get_params().get('feature_types')
+        feature_types = list(prev) if prev is not None else ['q'] * n_features
+        feature_types[cat_index] = 'c'
+        target.set_params(feature_types=feature_types, enable_categorical=True)
+    elif module == 'sklearn' and name in (
+        'HistGradientBoostingRegressor', 'HistGradientBoostingClassifier'
+    ):
+        prev = target.get_params().get('categorical_features')
+        if prev is None or isinstance(prev, str):
+            prev = []
+        prev = np.asarray(prev)
+        if prev.dtype == bool:
+            prev = np.flatnonzero(prev)
+        target.set_params(
+            categorical_features=sorted(set(prev.tolist()) | {cat_index})
+        )
+
+    return fit_kwargs
+
+
+def resolve_categorical_feature_names(
+    estimator: object,
+    feature_names: list[str],
+    fit_kwargs: dict[str, Any]
+) -> dict[str, object]:
+    """
+    PROTOTYPE (D-NP2). Translate to positions the categorical features the
+    user has set by column name on the estimator or in `fit_kwargs`, since the
+    estimator receives a numpy array.
+    """
+
+    target = estimator[-1] if isinstance(estimator, Pipeline) else estimator
+    name = type(target).__name__
+    module = type(target).__module__.split('.')[0]
+
+    def to_index(values):
+        return [feature_names.index(v) if isinstance(v, str) else v for v in values]
+
+    key = {'lightgbm': 'categorical_feature', 'catboost': 'cat_features'}.get(module)
+    if key is not None:
+        values = fit_kwargs.get(key)
+        if isinstance(values, (list, tuple)) and any(isinstance(v, str) for v in values):
+            fit_kwargs[key] = to_index(values)
+    elif module == 'sklearn' and name in (
+        'HistGradientBoostingRegressor', 'HistGradientBoostingClassifier'
+    ):
+        values = target.get_params().get('categorical_features')
+        if isinstance(values, (list, tuple)) and any(isinstance(v, str) for v in values):
+            target.set_params(categorical_features=to_index(values))
+
+    return fit_kwargs
+
+
+def train_matrix_for_catboost(
+    X: pd.DataFrame,
+    fit_kwargs: dict[str, Any],
+    estimator: object,
+    feature_names: list[str]
+) -> pd.DataFrame | None:
+    """
+    PROTOTYPE (D-NP2), variant for CatBoost with categorical features: keep
+    the DataFrame (an `object` array of the whole matrix is avoided), with the
+    values, not the codes, of the `category` columns. Returns None when it
+    does not apply.
+    """
+
+    target = estimator[-1] if isinstance(estimator, Pipeline) else estimator
+    if (
+        os.environ.get('DNP2_CATBOOST_DF') != '1'
+        or 'cat_features' not in fit_kwargs
+        or type(target).__module__.split('.')[0] != 'catboost'
+    ):
+        return None
+    cat_cols = [
+        col for col, dtype in X.dtypes.items() if isinstance(dtype, pd.CategoricalDtype)
+    ]
+    if cat_cols:
+        X = X.copy(deep=False)
+        for col in cat_cols:
+            X[col] = X[col].astype(float)
+    return cast_catboost_categorical_columns_dataframe(
+        X=X, fit_kwargs=fit_kwargs, estimator=estimator, feature_names=feature_names
+    )
+
+
+def train_matrix_to_numpy(X: pd.DataFrame) -> np.ndarray:
+    """
+    PROTOTYPE (D-NP2). Training matrix of the multi-series forecaster as the
+    float array the estimator receives.
+    """
+
+    try:
+        return X.to_numpy(dtype=float)
+    except (ValueError, TypeError) as e:
+        not_numeric = [
+            col for col, dtype in X.dtypes.items()
+            if isinstance(dtype, pd.CategoricalDtype)
+            and not pd.api.types.is_numeric_dtype(dtype.categories.dtype)
+        ]
+        raise TypeError(
+            f"Columns {not_numeric} have a `category` dtype with non-numeric "
+            f"values and are not included in `categorical_features`. Include "
+            f"them, or use `categorical_features='auto'`."
+        ) from e
+
