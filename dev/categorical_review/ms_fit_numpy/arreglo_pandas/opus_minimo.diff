+def _category_exog_to_values(
+    X: pd.DataFrame,
+    exclude: list[str] | None = None,
+    warn: bool = False
+) -> pd.DataFrame:
+    """
+    Replace the columns of dtype `category` with integer categories of `X`
+    (except those in `exclude`) by their values as float64, the values the
+    estimator receives in `predict`. A shallow copy is returned if any
+    column is replaced.
+
+    Parameters
+    ----------
+    X : pandas DataFrame
+        Training matrix.
+    exclude : list, default None
+        Columns that are kept as they are.
+    warn : bool, default False
+        If `True`, a `DataTypeWarning` names the replaced columns.
+
+    Returns
+    -------
+    X : pandas DataFrame
+        Training matrix with the replaced columns.
+
+    """
+
+    exclude = set(exclude) if exclude is not None else set()
+    cols = [
+        col for col, dtype in X.dtypes.items()
+        if isinstance(dtype, pd.CategoricalDtype)
+        and col not in exclude
+        and pd.api.types.is_integer_dtype(dtype.categories.dtype)
+    ]
+    if not cols:
+        return X
+
+    if warn:
+        warnings.warn(
+            f"The exogenous variables {cols} have dtype `category` but "
+            f"are not included in `categorical_features`, so the forecaster does "
+            f"not encode them: the estimator receives their values, not their "
+            f"category codes, as numeric columns. To treat them as categorical "
+            f"features, include them in `categorical_features` or use "
+            f"`categorical_features='auto'`.",
+            DataTypeWarning
+        )
+
+    # NOTE: The integer dtype of the categories is kept when there are no
+    # missing values: CatBoost does not accept float values in the
+    # categorical features configured in its constructor.
+    X = X.copy(deep=False)
+    for col in cols:
+        values = X[col]
+        if values.isna().any():
+            X[col] = np.asarray(values, dtype=float)
+        else:
+            X[col] = values.astype(values.cat.categories.dtype)
+
+    return X
+
+
