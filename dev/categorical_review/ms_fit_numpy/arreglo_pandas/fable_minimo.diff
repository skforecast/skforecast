+def _category_columns_to_values(
+    X_train: pd.DataFrame,
+    warn: bool = True
+) -> pd.DataFrame:
+    """
+    Replace the exogenous variables of dtype `category` of the training matrix
+    `X_train` by their values (their categories, not their codes) as float,
+    the same values the estimator receives in `predict`. The categorical
+    features encoded by the forecaster are float columns at this point, so a
+    `category` column is an exogenous variable that is not included in
+    `categorical_features`. The series identifier (`_level_skforecast`) is
+    kept: its values are its codes.
+
+    Parameters
+    ----------
+    X_train : pandas DataFrame
+        Training values (predictors).
+    warn : bool, default True
+        If `True`, a warning names the columns that are replaced.
+
+    Returns
+    -------
+    X_train : pandas DataFrame
+        Training matrix. The same object if there is nothing to replace,
+        otherwise a shallow copy with the columns replaced.
+
+    """
+
+    columns = [
+        col for col, dtype in X_train.dtypes.items()
+        if isinstance(dtype, pd.CategoricalDtype) and col != '_level_skforecast'
+    ]
+    if not columns:
+        return X_train
+
+    not_integer = [
+        col for col in columns
+        if not pd.api.types.is_integer_dtype(X_train[col].cat.categories.dtype)
+    ]
+    if not_integer:
+        raise TypeError(
+            f"The following exogenous variables cannot be passed to the "
+            f"estimator as numeric values: {not_integer}. Include them in "
+            f"`categorical_features`, or use `categorical_features='auto'`, so "
+            f"that the forecaster encodes them. A column of dtype `category` "
+            f"that is not included in `categorical_features` must have integer "
+            f"categories."
+        )
+
+    if warn:
+        warnings.warn(
+            f"The exogenous variables {columns} have dtype `category` but are "
+            f"not included in `categorical_features`, so the forecaster does "
+            f"not encode them: the estimator receives their values, not their "
+            f"category codes, as numeric columns. To treat them as categorical "
+            f"features, include them in `categorical_features` or use "
+            f"`categorical_features='auto'`.",
+            DataTypeWarning
+        )
+
+    X_train = X_train.copy(deep=False)
+    for col in columns:
+        X_train[col] = X_train[col].to_numpy(dtype=float, na_value=np.nan)
+
+    return X_train
+
+
