df = df.query("timestamp < '2016-11-29'").tail(context_length + h)
gluonts_dataset = PandasDataset.from_long_dataframe(
    df,
    item_id="id",
    timestamp="timestamp",
    target="target",
    feat_dynamic_real=["Generation forecast", "System load forecast"],
    future_length=h,
)

